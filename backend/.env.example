APP_NAME=FreelanceFlow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# SQLite is the easiest local setup. For MySQL, see README.md.
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=freelanceflow
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_COOKIE=freelanceflow-session
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost,127.0.0.1
FRONTEND_URL=http://localhost:5173

# Production: APP_ENV=production enforces secure cookies and SameSite=None.
# Set SANCTUM_STATEFUL_DOMAINS to the deployed frontend hostname.

# Required by AdminUserSeeder; set these only in the environment used for seeding.
ADMIN_NAME="FreelanceFlow Admin"
ADMIN_EMAIL=
ADMIN_PASSWORD=

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_SCHEME=
MAIL_TIMEOUT=10
MAIL_EHLO_DOMAIN=localhost
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@freelanceflow.test"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_CONTACT_RECIPIENT=

MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=

VITE_APP_NAME="${APP_NAME}"
